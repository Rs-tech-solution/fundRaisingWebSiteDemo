window.$=jQuery.noConflict();let mktoForms=[];$('form.mktoForm').each(function(){mktoForms.push(parseInt($(this).attr('data-FormId')));});if(mktoForms.length!=0){window.showModal=true;var mktoFormConfig={podId:"//learn.classy.org",munchkinId:"673-DCU-558",formIds:mktoForms};var script=document.createElement('script');script.onload=function(){mktoFormChain(mktoFormConfig,formScripts);};script.src="//learn.classy.org/js/forms2/js/forms2.min.js";if(document.cookie.match(/^(.*;)?\s*ClassyExitModal\s*=\s*[^;]+(.*)?$/)){window.showModal=false;}
document.head.appendChild(script);if(mktoForms.indexOf(2068)!==-1&&window.showModal==true&&!($('.c-upgrade-modal').length)){$(document).on('mouseleave',leaveFromTop);}
if((mktoForms.indexOf(1001)!==-1)&&window.getsEIN&&($('body.page-wp-fundraising-demo-b').length||$('body.page-fundraising-demo').length)){einStepOne('1001');}
if((mktoForms.indexOf(1002)!==-1)&&window.getsEIN&&($('body.page-wp-pricing-b').length||$('body.page-pricing').length)){einStepOne('1002');}}
function formatOrg(org){if(org.loading){return org.text;}
const $container=$("<div class='select2-result-org'>"
+"<div class='select2-result-org__wrap'>"
+"<div class='select2-result-org__img'><img /></div>"
+"<div class='select2-result-org__text'>"
+"<div class='select2-result-org__name'></div>"
+"<div class='select2-result-org__ein'></div>"
+'</div>'
+'</div>'
+'</div>',);if(!org.logo){org.logo='/wp-content/themes/classy_giv_tue/src/img/logo-ein-classy-placeholder.png';}
$container.find('.select2-result-org__name').html(org.hname);$container.find('.select2-result-org__ein').html(org.city+', '+org.state+" &bull; "+`EIN: ${org.id}`);$container.find('.select2-result-org__img img').attr('src',org.logo);return $container;}
function einStepOne(formid){let $thisform=$('#page form[data-formid="'+formid+'"]');if($thisform.length){var stepOne='<div class="ein-wrap">'+'<form class="mktoForm ein-step-one">'+'<div class="mktoFormRow ein-title title-one"><span class="step-number">1</span><h3>Find Your Organization</h3><div class="step-bars"><span class="first"></span><span class="second"></span></div></div>'+'<div class="mktoFormRow select-wrap"><div class="mktoFieldDescriptor mktoFormCol" style="margin-bottom: 5px;"><div class="mktoOffset" style="width: 5px;"></div><div class="mktoFieldWrap mktoRequiredField">'+'<label for="step-one-country" id="label-step-one-country" class="mktoLabel mktoHasWidth" style="width: 100px;">Country</label>'+'<div class="mktoGutter mktoHasWidth" style="width: 5px;"></div>'+'<select id="step-one-country" name="step-one-country" aria-labelledby="step-one-country" class="mktoField mktoHasWidth mktoRequired" aria-required="true" style="width: 150px;"><option value="">Select</option><option value="United States">United States</option><option value="Other">Other</option></select></div></div></div>'+'<div class="mktoFormRow country-response" style="display: none;"><p>Organizations on Classy must be headquartered in the United States, but their programs can operate anywhere in the world.</p></div>'+'<div class="mktoFormRow cn-select-wrap select-wrap"><div class="mktoFieldDescriptor mktoFormCol" style="margin-bottom: 5px;"><label  for="ein-select" id="label-ein-select" class="mktoLabel mktoHasWidth">Nonprofit</label><select class="cn-select mktoRequired mktoInvalid" id="ein-select"></select></div>'+'<div class="mktoFormRow html-wrap"><p><a href="#" class="not-listed">Nonprofit not listed?</a></p></div>'+'<div class="mktoButtonRow"><span class="mktoButtonWrap mktoNative" style="margin-left: 110px;"><button class="mktoButton" disabled>Continue</button></span></div>'+'</form></div>';var stepTwoTitle='<div class="mktoFormRow ein-title title-two"><span class="step-number">2</span><h3>Share More Details</h3><div class="step-bars"><span class="first"><a href="#" class="back-to-one"></a></span><span class="second"></span></div></div>';$(stepOne).insertBefore($thisform);$(stepTwoTitle).prependTo($thisform);$thisform.addClass('inactive');$('a.not-listed').on('click',function(){$('div.ein-wrap').fadeOut('fast',function(){$thisform.removeClass('inactive');});});$('.ein-step-one select').on('change',function(){if($('.ein-step-one #step-one-country').val()=='Other'){$('.mktoFormRow.country-response').fadeIn('fast');}else{$('.mktoFormRow.country-response').hide();}
if($('.ein-step-one #step-one-country').val()=='United States'&&$('.ein-step-one select.cn-select').val()){$('.ein-step-one .mktoButton').prop('disabled',false);}else{$('.ein-step-one .mktoButton').prop('disabled',true);}});$('.ein-step-one .mktoButton').on('click',function(){if(!$('.ein-step-one .mktoButton').prop('disabled')){let data=window.einData;if(data){$thisform.find('input[name="Company"]').val(data.text);$thisform.find('input[name="Website"]').val(data.website);$thisform.find('input[name="EIN__c"]').val(data.id);}
$('div.ein-wrap').fadeOut('fast',function(){$thisform.removeClass('inactive');});}
return false;});$('.back-to-one').on('click',function(){$('div.ein-wrap').show();$thisform.addClass('inactive');return false;});$('.cn-select').select2({width:'100%',dropdownParent:$('.mkto-form-wrap'),minimumInputLength:3,placeholder:'Search by nonprofit legal name or EIN',allowClear:true,templateResult:formatOrg,debug:true,ajax:{url:'/wp-content/themes/classy_giv_tue/public/npo-search.php',dataType:'json',delay:300,processResults:function(data,params){const results=[];$.each(data.hits,(index,org)=>{results.push({id:org.einDisplay,text:org.name,hname:org._highlightResult.name.value,website:org.websiteUrl,mission:org.missionAreaPrimary,contacts:org.contacts,logo:org.logoUrl,city:org.address.city,state:org.address.state,});});console.log(results);return{results:results,pagination:{more:params.page*15,},};},data:function(params){const query={query:params.term,country_code:'US',page:params.page||1};return query;},},});$('.cn-select').on('select2:select',(e)=>{window.einData=(e.params.data);const{data}=e.params;const ein=data.id;const{text}=data;const{mail1}=data;const{mail2}=data;const{city}=data;const{state}=data;const{zip}=data;const{website}=data;$('form input[id="Company"]').val(text);$('form input[id="EIN__c"]').val(ein);if(mail2){$('form textarea[id="Address"]').val(`${mail1}\n${mail2}`);}
else{$('form textarea[id="Address"]').val(mail1);}
$('form input[id="City"]').val(city);$('form select[id="state__c"]').val(state);$('form input[id="PostalCode"]').val(zip);$('form input[id="Website"]').val(website);$('form input[id="usedCNAPI"]').prop('checked',true);});$('.cn-select').on('select2:clear',()=>{$(':input','#mktoForm_1859').not(':button, :submit, :reset, [type=hidden]').val('').prop('checked',false).prop('selected',false);});}}
function leaveFromTop(e){if(e.clientY<0&&window.showModal){$.magnificPopup.open({items:{src:'.mkto-exit-wrap',type:'inline',},removalDelay:500,mainClass:'mfp-fade',callbacks:{beforeOpen:function(){$('body').addClass('mfp-active');setCookie('ClassyExitModal',1,1);window.showModal=false;},beforeClose:function(){$('body').removeClass('mfp-active');}}});}}
function formScripts(){if(window.MktoForms2){MktoForms2.whenReady((form)=>{let $thisForm=form.getFormElem();$thisForm.find('.mktoFormRow').each(function(){if($(this).find('input').length){let inputtype=$(this).find('input').attr('type');let inputname=$(this).find('input').attr('name');$(this).addClass('input-wrap field-'+inputname.toLowerCase()+' type-'+inputtype);}
if($(this).find('.mktoHtmlText').length){$(this).addClass('html-wrap');}
if($(this).find('select').length){$(this).addClass('select-wrap');}
if($(this).find('textarea').length){$(this).addClass('textarea-wrap');}
if($(this).find('input[name=productRequestType]').length){$(this).find('input[name=productRequestType]').val(window.location.pathname);}
const urlParams=new URLSearchParams(window.location.search);const npc=urlParams.get('npc');if($(this).find('input[name=nPCRequest]').length&&npc){$(this).find('input[name=nPCRequest]').val('true');}});$('.cb-subscribe-form__form-c .mktoButton').text('Subscribe');form.onSuccess((values)=>{if($thisForm.parents('.c-demo-form, .c-form-demo').length){let name=values.FirstName;$('.c-form-demo__success-name').text(name);$('.js-request-demo-text, .js-request-demo-form-wrapper').hide();$('.js-request-demo-text-success, .js-request-demo-success-container').show();$('.c-form-demo__left-wrapper-1').hide();$('.c-form-demo__left-success').show();$('body, html').animate({scrollTop:$thisForm.parents('section').offset().top-90},600);return false;}
if($thisForm.parents('.cb-subscribe-form__block, .classy-blog__subscribe').length){$('.cb-subscribe-form__block--left').hide();$('.cb-subscribe-form__block--right').css({'max-width':'100%','flex-basis':'100%','text-align':'center',});$('.form-sub-static').hide();$('.form-sub-new').show();return false;}
if($thisForm.parents('.c-form-demo__form-wrapper').length){$('.mkto-form-wrap').hide();$('.mkto-confirmation').addClass('animated fadeInUp').show();$("html, body").animate({scrollTop:0},"fast");return false;}
if($thisForm.parents('.mkto-exit-wrap').length){$('.mkto-exit-wrap .c-exit-modal-content').hide();$('.mkto-exit-wrap .confirmation').show();setTimeout(()=>$.magnificPopup.close(),3000);return false;}
if($thisForm.parents('.mkto-upgrade-wrap').length){$('.mkto-upgrade-wrap .c-upgrade-modal-content').hide();$('.mkto-upgrade-wrap .confirmation').show();setTimeout(()=>$.magnificPopup.close(),3000);return false;}
if($thisForm.parents('.mkto-pricing-wrap').length){$('.mkto-pricing-wrap .form-contents, .mkto-pricing-wrap > h2').hide();$('.mkto-pricing-wrap .confirmation').show();setTimeout(()=>$.magnificPopup.close(),3000);return false;}
if($thisForm.parents('.mkto-gate-wrap').length&&$('body').hasClass('page-resource-library')){setCookie('ClassyGate',1,365);$.magnificPopup.close();return false;}
if($thisForm.parents('.mkto-report-wrap').length&&$('body').hasClass('page-template-template-online-report')){setCookie('ClassyGateWAG',1,365);$.magnificPopup.close();return false;}
if($thisForm.parents('.mkto-report-wrap').length&&$('body').hasClass('page-template-template-online-report-somp23')){setCookie('ClassyGateSOMP',1,365);$.magnificPopup.close();return false;}
if($thisForm.parents('.mkto-connect-wrap').length&&$('body').hasClass('page-template-template-online-report-somp23')){$('.mkto-connect-wrap .form-contents').hide();$('.mkto-connect-wrap .mkto-connect-response').show();setTimeout(()=>$.magnificPopup.close(),3000);return false;}});});}}
function mktoFormChain(config,callback){var arrayify=getSelection.call.bind([].slice);var MKTOFORM_ID_ATTRNAME="data-formId";MktoForms2.whenRendered(function(form){var formEl=form.getFormElem()[0],rando="_"+new Date().getTime()+Math.random();arrayify(formEl.querySelectorAll("label[for]")).forEach(function(labelEl){var forEl=formEl.querySelector('[id="'+labelEl.htmlFor+'"]');if(forEl){labelEl.htmlFor=forEl.id=forEl.id+rando;}});});arrayify(config.formIds).forEach(function(formId){var loadForm=MktoForms2.loadForm.bind(MktoForms2,config.podId,config.munchkinId,formId),formEls=arrayify(document.querySelectorAll("["+MKTOFORM_ID_ATTRNAME+'="'+formId+'"]'));(function loadFormCb(formEls){var formEl=formEls.shift();formEl.id="mktoForm_"+formId;loadForm(function(form){formEl.id="";if(formEls.length){loadFormCb(formEls);}});})(formEls);});callback();}
function setCookie(cname,cvalue,exdays){const d=new Date();d.setTime(d.getTime()+(exdays*24*60*60*1000));let expires="expires="+d.toUTCString();document.cookie=cname+"="+cvalue+";"+expires+";path=/";}