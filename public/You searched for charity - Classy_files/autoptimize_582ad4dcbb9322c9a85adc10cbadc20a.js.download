(this).removeClass('gray');\n  });\n  /**\n  * Click outside menu\n  */\n\n  function clickMenu() {\n    if ($(window).width() < 1201) {\n      $(document).click(event => {\n        const $target = $(event.target);\n\n        if (!$target.closest('header').length) {\n          hideMenu();\n        }\n      });\n    } else {\n      $(document).click(event => {\n        const $target = $(event.target);\n\n        if (!$target.closest('header nav').length) {\n          hideMenu(false);\n        }\n      });\n    }\n  }\n\n  $(document).ready(() => {\n    clickMenu();\n  });\n  $(window).on('resize', () => {\n    if ($(window).width() < 1201) {\n      $(document).click(event => {\n        const $target = $(event.target);\n\n        if (!$target.closest('header').length) {\n          hideMenu();\n        }\n      });\n    } else {\n      $(document).click(event => {\n        const $target = $(event.target);\n\n        if (!$target.closest('header nav').length) {\n          hideMenu();\n        }\n      });\n    }\n  });\n  $('.header-new #nav-toggle').on('change', function (e) {\n    //console.log('burger toggle');\n    $('.header-new nav ul li').removeClass('open');\n  });\n  $('.header-new nav > ul').on('mouseenter', function () {\n    $('.page-nav-underlay').addClass('active');\n  });\n  $('.header-new nav > ul').on('mouseleave', function () {\n    $('.page-nav-underlay').removeClass('active');\n  });\n  $('.header-new nav > ul > li > a').on('click', function () {\n    //console.log('top level clicked');\n    if ($(window).width() < 992) {\n      $(this).parent().toggleClass('open');\n    }\n\n    return false;\n  });\n}\n// CONCATENATED MODULE: ./src/js/footer.js\n\nfunction initFooter() {\n  const $menuLinks = $('.js-footer-menu-button');\n\n  if ($menuLinks.length) {\n    $menuLinks.click(function (event) {\n      event.preventDefault();\n\n      if (isMobile()) {\n        $(this).toggleClass('open');\n        $(this).parent().find('ul').slideToggle();\n      }\n    });\n    $(window).resize(() => {\n      $menuLinks.parent().find('ul').hide();\n    });\n  }\n}\n// CONCATENATED MODULE: ./src/js/wow.js\nfunction initWOW() {\n  const wow = new WOW({\n    mobile: false,\n    live: true\n  });\n  wow.init();\n}\n// CONCATENATED MODULE: ./src/js/inView.js\n/**\n * Check if element is in view\n * @param {HTMLElement} element - html DOM Node\n * @param {number} offset - offset from bottom of screen\n */\nfunction inView(element, offset = 0) {\n  if (element) {\n    const elementHeight = element.clientHeight; // get window height\n\n    const windowHeight = window.innerHeight; // get number of pixels that the document is scrolled\n\n    const scrollY = window.scrollY || window.pageYOffset; // get current scroll position\n    // (distance from the top of the page to the bottom of the current viewport)\n\n    const scrollPosition = scrollY + windowHeight; // get element position (distance from the top of the page to the bottom of the element)\n\n    const elementPosition = element.getBoundingClientRect().top + scrollY + elementHeight + offset; // is scroll position greater than element position? (is element in view?)\n\n    if (scrollPosition > elementPosition) {\n      return true;\n    }\n\n    return false;\n  }\n\n  return false;\n}\n/**\n *\n * @param {string} selector - html selector\n * @param {function} callback - fired when element enter inside viewport\n * @param {number} offset - offset from bottom of screen\n */\n\nfunction initInViewWatch(selector, callback, offset = 0) {\n  // get the element to animate\n  const element = document.querySelector(selector); // animate element when it is in view\n\n  function handleScroll() {\n    // is element in view?\n    if (inView(element, offset) && typeof callback === 'function') {\n      callback();\n    }\n  } // listen for scroll event and call animate function\n\n\n  document.addEventListener('scroll', handleScroll);\n}\n// CONCATENATED MODULE: ./src/js/reach-list.js\n\n\n\nfunction initSectionPagination() {\n  const $pagination = $('.js-reach-list-pagination');\n  const $sections = $('.js-reach-section');\n  const screenCenter = window.innerHeight / 2;\n  let scheduledAnimationFrame;\n  /**\n  * Set active pagination item (vertical dots)\n  */\n\n  function setActivePaginationItem() {\n    scheduledAnimationFrame = false;\n    $sections.each((i, el) => {\n      const elPositionRelativeToWindow = $(el).offset().top - $(window).scrollTop();\n\n      if (elPositionRelativeToWindow > 0 && elPositionRelativeToWindow < window.innerHeight && elPositionRelativeToWindow < screenCenter) {\n        $pagination.find('a').removeClass('c-reach-pagination__item--active');\n        $pagination.find(`a[data-section-id='${el.getAttribute('id')}']`).addClass('c-reach-pagination__item--active');\n      }\n    });\n  }\n\n  function onScroll() {\n    // Prevent multiple rAF callbacks.\n    if (scheduledAnimationFrame) {\n      return;\n    }\n\n    scheduledAnimationFrame = true;\n    requestAnimationFrame(setActivePaginationItem);\n  }\n  /**\n  * Click on pagination item (vertical dots)\n  */\n\n\n  $pagination.find('a').click(function (event) {\n    event.preventDefault();\n    const $section = $(`.js-reach-section#${$(this).data('section-id')}`);\n    const elOffset = $section.offset().top;\n    $([document.documentElement, document.body]).animate({\n      scrollTop: elOffset - (window.innerHeight / 2 - $section.height() / 2)\n    });\n  });\n  $(window).scroll(onScroll);\n  $(document).ready(setActivePaginationItem);\n}\n\nfunction initImageTransitionBetweenSections() {\n  const $pin1 = $('.js-home-hero-transition-wrapper');\n  const $pin2 = $('.js-home-hero-pin-2');\n  if (!$pin1.length || !$pin2.length) return;\n  let alreadyAnimatedToReachList = false;\n  let alreadyAnimatedToHero = false;\n  /*------------------------------------*/\n\n  const transitionWrapper = $('.js-home-hero-transition-wrapper');\n  $(transitionWrapper).css({\n    width: $pin1.find('> img').attr('width'),\n    height: $pin1.find('> img').attr('height')\n  });\n  $pin1.find('> img').css({\n    opacity: 0\n  }); // window.setTimeout(() => {\n  //     $(transitionWrapper).css(\n  //         'background-image',\n  //         `url(' ${$pin1.find('> img').attr('src')}')`,\n  //     );\n  // // $pin1.find('> img').css({ opacity: 1 });\n  // }, 900);\n\n  /*------------------------------------*/\n\n  const controller = new ScrollMagic.Controller();\n  new ScrollMagic.Scene({\n    triggerElement: '.js-home-hero-pin-2',\n    triggerHook: 0.65\n  }).on('enter', () => {\n    if (!alreadyAnimatedToReachList && !isMobile()) {\n      $(transitionWrapper).animate({\n        left: $pin2.offset().left - $pin1.offset().left + 178,\n        top: $pin2.offset().top - $pin1.offset().top + 36,\n        width: '300px',\n        height: '475px',\n        backgroundPositionX: '-100px',\n        marginLeft: '165px'\n      }, 1000, () => {\n        alreadyAnimatedToReachList = true;\n        alreadyAnimatedToHero = false;\n      });\n    }\n  }).addTo(controller);\n  new ScrollMagic.Scene({\n    triggerElement: '.js-home-hero-pin-1',\n    triggerHook: 0.2,\n    offset: window.innerHeight / 2\n  }).on('leave', () => {\n    if (!alreadyAnimatedToHero && !isMobile()) {\n      $(transitionWrapper).animate({\n        left: 0,\n        top: 0,\n        width: $pin1.find('> img').attr('width'),\n        height: $pin1.find('> img').attr('height'),\n        backgroundPositionX: 0,\n        marginLeft: '0'\n      }, 1000, () => {\n        alreadyAnimatedToReachList = false;\n        alreadyAnimatedToHero = true;\n      });\n    }\n  }).addTo(controller);\n}\n\nfunction initReachList() {\n  initSectionPagination();\n  initInViewWatch('.c-reach-list .wrap', () => {\n    if (!isMobile()) {\n      $('.wrap').addClass('wrap--visible');\n    }\n  }, 0);\n  initImageTransitionBetweenSections();\n}\n// CONCATENATED MODULE: ./src/js/magnific.js\n\n/**\n * Magnific Popup\n */\n\nfunction initPopup() {\n  $('.js-popup').each(function popup() {\n    const $this = $(this);\n    $this.magnificPopup({\n      type: 'iframe',\n      mainClass: 'mfp-fade',\n      fixedContentPos: false,\n      callbacks: {\n        open: () => {\n          scrollControll().disableScroll();\n        },\n        close: () => {\n          scrollControll().enableScroll();\n        }\n      }\n    });\n  });\n}\n// CONCATENATED MODULE: ./src/js/logos-carousel.js\nfunction initLogosCarousel() {\n  const $sliderContainer = $('.js-logos-carousel-container');\n  const slidesToShow = parseInt($sliderContainer.data('slide-to-show'), 10) || 5;\n  const autoplaySpeed = parseInt($sliderContainer.data('autoplay-speed'), 10) || 4000;\n  const slidesToScroll = parseInt($sliderContainer.data('slide-to-scroll'), 10) || 1;\n  const speed = parseInt($sliderContainer.data('speed'), 10) || 500;\n  const autoplay = !!$sliderContainer.data('autoplay');\n  const options = {\n    arrows: false,\n    speed,\n    autoplay,\n    autoplaySpeed,\n    slidesToShow,\n    slidesToScroll,\n    responsive: [{\n      breakpoint: 1199,\n      settings: {\n        slidesToShow: 4\n      }\n    }, {\n      breakpoint: 991,\n      settings: {\n        slidesToShow: 3\n      }\n    }, {\n      breakpoint: 767,\n      settings: {\n        slidesToShow: 2\n      }\n    }, {\n      breakpoint: 575,\n      settings: {\n        slidesToShow: 1,\n        slidesPerRow: 1,\n        rows: slidesToShow,\n        adaptiveHeight: true,\n        centerMode: true\n      }\n    }]\n  };\n\n  if ($sliderContainer.length) {\n    $($sliderContainer).slick(options);\n  }\n}\nfunction initLogosCarouselWithArrow() {\n  const $sliderContainer = $('.js-logos-carousel-container-with-arrow');\n  const $prevArrow = $('.js-arrow-prev', $sliderContainer.closest('.js-logos-carousel'));\n  const $nextArrow = $('.js-arrow-next', $sliderContainer.closest('.js-logos-carousel'));\n  const slidesToShow = parseInt($sliderContainer.data('slide-to-show'), 10) || 5;\n  const autoplaySpeed = parseInt($sliderContainer.data('autoplay-speed'), 10) || 4000;\n  const slidesToScroll = parseInt($sliderContainer.data('slide-to-scroll'), 10) || 1;\n  const speed = parseInt($sliderContainer.data('speed'), 10) || 500;\n  const autoplay = !!$sliderContainer.data('autoplay');\n  const options = {\n    speed,\n    autoplay,\n    // autoplay: false,\n    autoplaySpeed,\n    slidesToShow,\n    slidesToScroll,\n    prevArrow: $prevArrow,\n    nextArrow: $nextArrow,\n    responsive: [{\n      breakpoint: 1199,\n      settings: {\n        slidesToShow: 4,\n        slidesToScroll: 4\n      }\n    }, {\n      breakpoint: 991,\n      settings: {\n        slidesToShow: 3,\n        slidesToScroll: 3\n      }\n    }, {\n      breakpoint: 767,\n      settings: {\n        slidesToShow: 2,\n        slidesToScroll: 2\n      }\n    }, {\n      breakpoint: 575,\n      settings: {\n        slidesToShow: 1,\n        slidesToScroll: 1,\n        adaptiveHeight: true\n      }\n    }]\n  };\n\n  if ($sliderContainer.length) {\n    $($sliderContainer).slick(options);\n  }\n}\n// CONCATENATED MODULE: ./src/js/tabs.js\nfunction initTabs() {\n  const $tabsContainer = $('.js-tabs');\n  const $tabs = $('.js-tab', $tabsContainer);\n  const $tabsContentContainer = $('.js-tabs-content');\n  const $tabsContentItem = $('.js-tabs-content-item', $tabsContentContainer);\n  $tabs.click(function (event) {\n    event.preventDefault();\n    const tabIndex = parseInt($(this).data('tab-index'), 10);\n\n    if (!Number.isNaN(tabIndex)) {\n      $tabs.removeClass('active');\n      $(this).addClass('active');\n      $tabsContentItem.removeClass('active');\n      $tabsContentItem.filter(`[data-content-index=${tabIndex}]`).addClass('active');\n    }\n  }); // tabs active-bar animation\n\n  const $tabContainer = $('.js-tab-container');\n\n  if ($tabContainer.length) {\n    const $tabBar = $('.js-tab-bar', $tabContainer);\n    const $tabItem = $('.js-tab-item', $tabContainer);\n    let $tabItemActive = $('.js-tab-item--active', $tabContainer);\n    let itemWidth;\n    let activeItemPaddLeft = 0;\n    let leftPos;\n\n    if ($tabItemActive.length === 1) {\n      itemWidth = $tabItemActive.width();\n      activeItemPaddLeft = parseFloat($tabItemActive.css('padding-left'));\n\n      if (Number.isNaN(activeItemPaddLeft)) {\n        activeItemPaddLeft = 0;\n      }\n\n      leftPos = $tabItemActive.offset().left - $tabContainer.offset().left + Math.round(activeItemPaddLeft);\n      $tabBar.width(itemWidth);\n      $tabBar.css('left', `${leftPos}px`);\n    }\n\n    $tabItem.click(function () {\n      itemWidth = $(this).width();\n      activeItemPaddLeft = parseFloat($(this).css('padding-left'));\n\n      if (Number.isNaN(activeItemPaddLeft)) {\n        activeItemPaddLeft = 0;\n      }\n\n      leftPos = $(this).offset().left - $tabContainer.offset().left + Math.round(activeItemPaddLeft);\n      $(this).addClass('js-tab-item--active');\n      $tabItemActive.removeClass('js-tab-item--active');\n      $tabBar.width(itemWidth);\n      $tabBar.css('left', `${leftPos}px`);\n      $tabItemActive = $(this);\n    });\n  }\n}\n// CONCATENATED MODULE: ./src/js/testimonials-horizontal-slider.js\nfunction initTestimonialsHorizontalSlider() {\n  const $sectionContainer = $('.js-testimonials-horizontal-slider-section');\n  const $sliderContainer = $('.js-testimonials-horizontal-slider', $sectionContainer);\n  $sliderContainer.slick({\n    prevArrow: $('.c-slider-arrow--prev', $sectionContainer),\n    nextArrow: $('.c-slider-arrow--next', $sectionContainer),\n    adaptiveHeight: true,\n    slidesToShow: 1\n  });\n}\n// CONCATENATED MODULE: ./src/js/form-validation.js\nfunction initFormValidation() {\n  $.validator.methods.pattern = function (value, element) {\n    return this.optional(element) || new RegExp(element.pattern).test(value);\n  };\n\n  $.validator.messages.pattern = 'Invalid input entered.';\n  $('.js-form-validator').each(function () {\n    $(this).validate({\n      errorClass: 'invalid'\n    });\n  });\n}\n// CONCATENATED MODULE: ./src/js/team.js\nfunction initTeamScript() {\n  const $teamPhoto = $('.js-team-foto');\n  $teamPhoto.click(function (event) {\n    event.preventDefault();\n    const $photoDesc = $('.js-team-foto-description', $(this));\n\n    if ($photoDesc.length) {\n      $(this).toggleClass('active');\n    }\n  });\n}\n// CONCATENATED MODULE: ./src/js/vertical-slider.js\nfunction verticalSlider() {\n  $('.vertical-slider-title-js').on('click', function (e) {\n    e.preventDefault();\n    $(this).parents('.vertical-slider__content').find('.vertical-slider-title-js').removeClass('active-title');\n    $(this).addClass('active-title');\n    const content = $(this).data('tab-show');\n    const topP = content - 1;\n    $(this).parents('.vertical-slider__content').find('.vertical-slider__right-block--img').removeClass('active-img');\n    $(this).parents('.vertical-slider__content').find(`.vertical-slider-img-js-${content}`).addClass('active-img');\n    $(this).parents('.vertical-slider__content').find('.vertical-slider__right-block--cont').css({\n      top: `-${topP}00%`\n    });\n  });\n  $('.vertical-slider__simple .vertical-slider__item-title-md').on('click', function (e) {\n    e.preventDefault();\n    $(this).parent('.vertical-slider__right-block--img').toggleClass('active-img');\n    $(this).parent('.vertical-slider__right-block--img').find('.js-md-tab-slide').slideToggle();\n  });\n}\n// CONCATENATED MODULE: ./src/js/simple-slider.js\nfunction initSimpleSlider() {\n  const $pagingInfo = $('.c-simple-slider__normal .pagingInfo');\n  const $slickSlider = $('.c-simple-slider__normal .c-simple-slider-wrapper');\n  const configObjectSimpleSlider = {\n    dots: false,\n    speed: 1000\n  };\n  configObjectSimpleSlider.prevArrow = $('.c-simple-slider__normal .c-slider-arrow--prev');\n  configObjectSimpleSlider.nextArrow = $('.c-simple-slider__normal .c-slider-arrow--next');\n  $slickSlider.on('init reInit afterChange', (event, slick, currentSlide) => {\n    let cur = 0;\n\n    if (!currentSlide) {\n      cur = 0;\n    } else {\n      cur = currentSlide;\n    }\n\n    const i = cur + 1;\n    $pagingInfo.text(`0${i} / 0${slick.slideCount}`);\n  });\n  $slickSlider.slick(configObjectSimpleSlider); // simple-slider mobile-slide-down\n\n  const $pagingInfo11 = $('.c-simple-slider__mobile-slide-down .pagingInfo');\n  const $slickSlider11 = $('.c-simple-slider__mobile-slide-down .c-simple-slider-wrapper');\n  const configObjectSimpleSlider11 = {\n    dots: false,\n    speed: 1000\n  };\n  configObjectSimpleSlider11.prevArrow = $('.c-simple-slider__mobile-slide-down .c-simple-slider__btn-left-mobile-slide-down');\n  configObjectSimpleSlider11.nextArrow = $('.c-simple-slider__mobile-slide-down .c-simple-slider__btn-right-mobile-slide-down');\n  $slickSlider11.on('init reInit afterChange', (event, slick11, currentSlide11) => {\n    let cur = 0;\n\n    if (!currentSlide11) {\n      cur = 0;\n    } else {\n      cur = currentSlide11;\n    }\n\n    const i = cur + 1;\n    $pagingInfo11.text(`0${i} / 0${slick11.slideCount}`);\n  });\n  let slickIsOpen11 = false;\n  $(window).on('load resize orientationchange', function () {\n    if (slickIsOpen11 && $(this).width() <= 767) {\n      $slickSlider11.slick('unslick');\n      slickIsOpen11 = false;\n      $('.c-simple-slider__mobile-slide-down .slide__expand-option').on('click', function () {\n        $(this).siblings('.slide__mobile-slide-down-wrapper').slideToggle(500);\n        $(this).children('.chevron-down-img').toggleClass('chevron-down-img-toggle');\n      });\n      $('.c-simple-slider__mobile-slide-down .slide-1 .slide__expand-option .chevron-down-img').addClass('chevron-down-img-toggle ');\n    } else if (!slickIsOpen11 && $(this).width() > 767) {\n      $slickSlider11.not('.slick-initialized').slick(configObjectSimpleSlider11);\n      slickIsOpen11 = true;\n    }\n  });\n  $(document).ready(function () {\n    if ($(this).width() >= 768) {\n      $slickSlider11.not('.slick-initialized').slick(configObjectSimpleSlider11);\n      slickIsOpen11 = true;\n    } else {\n      $('.c-simple-slider__mobile-slide-down .slide__expand-option').on('click', function () {\n        $(this).siblings('.slide__mobile-slide-down-wrapper').slideToggle(500);\n        $(this).children('.chevron-down-img').toggleClass('chevron-down-img-toggle');\n      });\n      $('.c-simple-slider__mobile-slide-down .slide-1 .slide__expand-option .chevron-down-img').addClass('chevron-down-img-toggle ');\n    }\n  }); // simple slider mobile full (slider new)\n\n  const $pagingInfo22 = $('.c-simple-slider__mobile-full .pagingInfo');\n  const $slickSlider22 = $('.c-simple-slider__mobile-full .c-simple-slider-wrapper');\n  const configObjectSimpleSlider22 = {\n    dots: false,\n    speed: 1000\n  };\n  configObjectSimpleSlider22.prevArrow = $('.c-simple-slider__mobile-full .c-simple-slider__btn-left-mobile-full');\n  configObjectSimpleSlider22.nextArrow = $('.c-simple-slider__mobile-full .c-simple-slider__btn-right-mobile-full');\n  $slickSlider22.on('init reInit afterChange', (event, slick22, currentSlide22) => {\n    let cur = 0;\n\n    if (!currentSlide22) {\n      cur = 0;\n    } else {\n      cur = currentSlide22;\n    }\n\n    const i = cur + 1;\n    $pagingInfo22.text(`0${i} / 0${slick22.slideCount}`);\n  });\n  let slickIsOpen22 = false;\n  $(window).on('load resize orientationchange', function () {\n    if (slickIsOpen22 && $(this).width() <= 767) {\n      $slickSlider22.slick('unslick');\n      slickIsOpen22 = false;\n    } else if (!slickIsOpen22 && $(this).width() > 767) {\n      $slickSlider22.not('.slick-initialized').slick(configObjectSimpleSlider22);\n      slickIsOpen22 = true;\n    }\n  });\n  $(document).ready(function () {\n    if ($(this).width() >= 768) {\n      $slickSlider22.not('.slick-initialized').slick(configObjectSimpleSlider22);\n      slickIsOpen22 = true;\n    }\n  }); // Giving Slider\n\n  const $pagingInfo33 = $('.c-giving-slider__btn-wrapper .pagingInfo');\n  const $slickSlider33 = $('.c-giving-slider-wrapper');\n  const configObjectSimpleSlider33 = {\n    dots: false,\n    speed: 1000\n  };\n  configObjectSimpleSlider33.prevArrow = $('.c-giving-slider__btn-wrapper .c-slider-arrow--prev');\n  configObjectSimpleSlider33.nextArrow = $('.c-giving-slider__btn-wrapper .c-slider-arrow--next');\n  $slickSlider33.on('init reInit afterChange', (event, slick, currentSlide) => {\n    let cur = 0;\n\n    if (!currentSlide) {\n      cur = 0;\n    } else {\n      cur = currentSlide;\n    }\n\n    const i = cur + 1;\n    $pagingInfo33.text(`0${i} / 0${slick.slideCount}`);\n  });\n  $slickSlider33.slick(configObjectSimpleSlider33);\n}\n// CONCATENATED MODULE: ./src/js/chess-blocks-video.js\nfunction initChessBlocksVideo() {\n  const $videoSections = $('.js-chess-video');\n\n  if ($videoSections.length) {\n    const $playButtons = $('.js-play-btn', $videoSections);\n\n    if ($playButtons.length) {\n      $playButtons.click(function (event) {\n        event.preventDefault();\n        const $video = $(this).closest('.js-chess-video').find('video');\n        $(this).hide();\n\n        if ($video.length && !$video.prop('autoplay')) {\n          $video[0].play();\n        }\n      });\n    }\n  }\n}\n// CONCATENATED MODULE: ./src/js/use-cases-slider.js\nfunction iniUseCasesSlider() {\n  const $section = $('.js-use-cases-section');\n  const $arrowPrev = $('.js-use-cases-arrow-prev', $section);\n  const $arrowNext = $('.js-use-cases-arrow-next', $section);\n  $('.js-use-cases-slider').slick({\n    centerMode: true,\n    prevArrow: $arrowPrev,\n    nextArrow: $arrowNext,\n    variableWidth: true\n  });\n}\n// CONCATENATED MODULE: ./src/js/integration.js\nfunction initIntegration() {\n  const notFound = $('.integrations-directory__not-found');\n  $('.js-integrations-directory-heading').on('click', function (e) {\n    e.preventDefault();\n    notFound.hide();\n    $('.integrations-directory__tab-heading--item').removeClass('active-tab-int');\n    $(this).addClass('active-tab-int');\n    $('.integrations-directory__tab-heading--list .integrations-directory__tab-heading--dropdown').text($(this).find('h4').text());\n    const content = $(this).find('h4').data('tabh');\n\n    if (content === 'all') {\n      $('.integrations-directory__block').css('visibility', 'hidden');\n      $(\"[class*='integrations-directory__tab--']\").addClass('tab-i-hide');\n      $(\"[class*='integrations-directory__tab--']\").removeClass('tab-i-hide');\n      requestAnimationFrame(() => $('.integrations-directory__block').css('visibility', 'visible'));\n\n      if (!$('.integrations-directory__tab-content .row').children(':visible:not(.integrations-directory__not-found)').size()) {\n        notFound.show();\n      }\n    } else {\n      $('.integrations-directory__block').css('visibility', 'hidden');\n      $(\"[class*='integrations-directory__tab--']\").addClass('tab-i-hide');\n      $(`.integrations-directory__tab--${content}`).removeClass('tab-i-hide');\n      requestAnimationFrame(() => $('.integrations-directory__block').css('visibility', 'visible'));\n\n      if (!$('.integrations-directory__tab-content .row').children(':visible:not(.integrations-directory__not-found)').size()) {\n        notFound.show();\n      }\n    }\n  });\n  $('.integrations-directory__tab-heading--list').on('click', function (e) {\n    e.preventDefault();\n\n    if ($(this).width() < 768) {\n      $('.integrations-directory__tab-heading--items').slideToggle({\n        start: function () {\n          jQuery(this).css('display', 'flex');\n        }\n      });\n    }\n  });\n  $(document).ready(() => {\n    $('#search-integration').keyup(function () {\n      const serchI = $(this).val().toLowerCase();\n      notFound.hide();\n      $('.list-integration').filter(function () {\n        const title = $(this).find('h4').text().toLowerCase();\n        const titleS = title.indexOf(serchI);\n        return $(this).toggle(titleS > -1);\n      });\n\n      if (!$('.integrations-directory__tab-content .row').children(':visible:not(.integrations-directory__not-found)').size()) {\n        notFound.show();\n      }\n    });\n  });\n}\n// CONCATENATED MODULE: ./src/js/expand-section.js\nfunction initExpandSection() {\n  // Settings Scroll images for dekstop\n  $(document).ready(() => {\n    let isOpenExpandSection = false;\n    const expandController = new ScrollMagic.Controller();\n    const scene1 = new ScrollMagic.Scene({\n      triggerElement: '.c-expand-section .c-expand-section__content',\n      duration: 1,\n      triggerHook: 0.18\n    });\n    scene1.setPin('.c-expand-section .c-expand-section__images');\n    const imagesNumber = $('.c-expand-section .c-expand-section__images img').length;\n    scene1.on('progress', event => {\n      if (isOpenExpandSection && event.progress <= 0.99 && event.progress >= 0.01) {\n        const imgNumber = Math.ceil(imagesNumber * event.progress);\n        $('.c-expand-section .c-expand-section__images img').removeClass('img-show');\n        $(`.c-expand-section .c-expand-section__images--${imgNumber}`).addClass('img-show');\n      }\n    });\n    expandController.addScene(scene1);\n    $('.c-expand-section .c-expand-section__expand-button').on('click', () => {\n      isOpenExpandSection = !isOpenExpandSection;\n      $('.c-expand-section .c-expand-section__expand-button-less').toggle();\n      $('.c-expand-section .c-expand-section__expand-button-more').toggle();\n      $('.c-expand-section .c-expand-section__expand-text').slideToggle(1000, () => {\n        if (isOpenExpandSection) {\n          $('.c-expand-section .c-expand-section__expand-text').css('display', 'inline');\n          $('.c-expand-section .c-expand-section__staff-images').css('display', 'flex');\n          const newSceneDuration = $('.c-expand-section .c-expand-section__content').height() - $('.c-expand-section .c-expand-section__images--1').height() - 80;\n          scene1.duration(newSceneDuration);\n        }\n      });\n\n      if (!isOpenExpandSection) {\n        scene1.duration(1);\n        $('.c-expand-section .c-expand-section__images img').removeClass('img-show');\n        $('.c-expand-section .c-expand-section__images--1').addClass('img-show');\n        $('.c-expand-section .c-expand-section__staff-images').css('display', 'none');\n      }\n    });\n  }); // Settings for Slider Mobile\n\n  const $expandSectionSlider = $('.c-expand-section .c-expand-section__mobile-slider');\n  $expandSectionSlider.slick({\n    dots: false,\n    speed: 1000,\n    prevArrow: $('.c-expand-section__btn-wrapper .c-expand-section__arrow-left'),\n    nextArrow: $('.c-expand-section__btn-wrapper .c-expand-section__arrow-right')\n  });\n}\n// CONCATENATED MODULE: ./src/js/pros_cons_slider.js\nfunction initProsConsSlider() {\n  const $prosConsSlider = $('.c-pros-cons-slider-wrapper');\n  const prevArrow = $('.c-pros-cons-slider__btn-wrapper .c-slider-arrow--prev');\n  const nextArrow = $('.c-pros-cons-slider__btn-wrapper .c-slider-arrow--next');\n  let isFirstSlide = true;\n  nextArrow.on('click', () => {\n    if (isFirstSlide) {\n      $($prosConsSlider).addClass('c-pros-cons-slider__trans');\n      isFirstSlide = !isFirstSlide;\n    }\n  });\n  prevArrow.on('click', () => {\n    if (!isFirstSlide) {\n      $($prosConsSlider).removeClass('c-pros-cons-slider__trans');\n      isFirstSlide = !isFirstSlide;\n    }\n  });\n  $prosConsSlider.on('mousedown', function (e) {\n    const clikedCoorX = e.pageX;\n    $(this).css('transform', '');\n    $(this).on('mousemove', event => {\n      $(this).css('transform', `translateX(${event.pageX - clikedCoorX}px)`);\n    });\n    $(this).on('mouseup', event => {\n      $(this).css('transform', '');\n\n      if (clikedCoorX - event.pageX >= 50) {\n        isFirstSlide = !isFirstSlide;\n        $($prosConsSlider).addClass('c-pros-cons-slider__trans');\n      }\n\n      if (clikedCoorX - event.pageX <= -50) {\n        isFirstSlide = !isFirstSlide;\n        $($prosConsSlider).removeClass('c-pros-cons-slider__trans');\n      }\n\n      $prosConsSlider.off('mousemove');\n      $prosConsSlider.off('mouseup');\n    });\n  });\n}\n// CONCATENATED MODULE: ./src/js/mobilizing-events.js\n\nfunction iniMobilizingEvents() {\n  const $items = $('.js-mobilizing-events-item');\n  $items.find('.js-mobilizing-events-poster').click(function (event) {\n    event.preventDefault();\n    const $modal = $(this).closest('.js-mobilizing-events-item').find('.js-mobilizing-events-modal');\n    const elem = $modal.clone();\n    const block = '<div class=\"js-mobilizing-events-poster--popup-v\"></div>';\n    $('body').append(block);\n    $('.js-mobilizing-events-poster--popup-v').append(elem);\n    $('.js-mobilizing-events-poster--popup-v .js-mobilizing-events-modal').show();\n\n    if ($modal.length) {\n      scrollControll().disableScroll();\n      $('.js-mobilizing-events-poster--popup-v .js-mobilizing-events-modal').find('.close-btn').click(e => {\n        e.preventDefault();\n        scrollControll().enableScroll();\n        setTimeout(() => {\n          $('.js-mobilizing-events-poster--popup-v').remove();\n        }, 900);\n      });\n    }\n  });\n}\n// CONCATENATED MODULE: ./src/js/jobs-list.js\nconst MAX_VISIBLE_JOBS = 7;\n/**\n *\n * @param {string|number} id - department ID\n * @returns Object[]\n */\n\nasync function getJobsList(id = '') {\n  const jobsList = [];\n  const result = await fetch(`https://boards-api.greenhouse.io/v1/boards/classy/departments/${id}`);\n  let departments = await result.json();\n\n  if (id) {\n    jobsList.push(...departments.jobs);\n  } else {\n    departments = departments.departments;\n    departments.forEach(el => {\n      if (Array.isArray(el.jobs) && el.jobs.length) {\n        jobsList.push(...el.jobs);\n      }\n    });\n  }\n\n  return jobsList;\n}\n/**\n *\n * @param {Object[]} jobsList\n */\n\n\nfunction insertJobsIntoHTML(jobsList) {\n  const tmpl = document.getElementById('job-list-item-template');\n  const wrapper = document.createElement('div');\n  jobsList.forEach(el => {\n    const a = tmpl.content.querySelector('a');\n    a.textContent = el.title;\n    a.setAttribute('href', `/careers-single?gh_jid=${el.id}`);\n    wrapper.append(tmpl.content.cloneNode(true));\n  });\n  document.querySelector('.js-job-list-wrapper').innerHTML = wrapper.innerHTML;\n  document.querySelector('.js-job-department-count span').innerHTML = jobsList.length;\n\n  if (jobsList.length > MAX_VISIBLE_JOBS) {\n    $('.js-job-view-more-btn-wrapper').show();\n  } else {\n    $('.js-job-view-more-btn-wrapper').hide();\n  }\n}\n\nasync function jobsListInit() {\n  const tmpl = document.getElementById('job-list-item-template');\n  const $container = $('.js-job-list-container');\n\n  if (tmpl) {\n    try {\n      $('.js-job-department-link-all').click(async function (event) {\n        event.preventDefault();\n        $('.js-job-department-link, .js-job-department-link-all').removeClass('active');\n        $(this).addClass('active');\n        insertJobsIntoHTML(await getJobsList());\n      });\n      $('.js-job-department-link').click(async function (event) {\n        event.preventDefault();\n        $('.js-job-department-link, .js-job-department-link-all').removeClass('active');\n        $(this).addClass('active');\n        const departamentID = $(this).data('department-id');\n        insertJobsIntoHTML(await getJobsList(departamentID));\n      });\n      $('.js-job-view-more-btn').click(function (event) {\n        event.preventDefault();\n        $('.js-job-item').removeClass('job--hidden');\n        $(this).hide();\n      });\n      $('.js-custom-select', $container).select2({\n        minimumResultsForSearch: Infinity\n      });\n      $('.js-custom-select').change(async function () {\n        const val = $(this).val();\n        $('.js-job-department-link, .js-job-department-link-all').removeClass('active');\n\n        if (val === 'all') {\n          $('.js-job-department-link-all').addClass('active');\n          insertJobsIntoHTML(await getJobsList());\n        } else {\n          $(`.js-job-department-link[data-department-id=${val}]`).addClass('active');\n          insertJobsIntoHTML(await getJobsList(val));\n        }\n      });\n    } catch (err) {// TO DO\n    }\n  }\n}\n// CONCATENATED MODULE: ./src/js/header-resource.js\n\nfunction initHeaderResource() {\n  const menuBtn = $('.c-header-resources .hamburger.js-menu-btn');\n  const $menuLinks = $('.c-header-resources__mobile-menu-item');\n  const $mobileMenu = $('.c-header-resources__mobile-menu-wrapper');\n  /**\n  * Show/hide mobile menu\n  */\n\n  menuBtn.click(event => {\n    event.preventDefault();\n    event.stopPropagation();\n\n    if (!$mobileMenu.length) {\n      return;\n    }\n\n    if ($mobileMenu.hasClass('open')) {\n      $mobileMenu.removeClass('open');\n      scrollControll().enableScroll();\n    } else {\n      $mobileMenu.addClass('open');\n      scrollControll().disableScroll();\n    }\n  });\n  /**\n  * Show/hide submenu\n  */\n\n  if ($menuLinks.length) {\n    $menuLinks.click(function (event) {\n      event.preventDefault();\n      $menuLinks.removeClass('resources__mobile-active');\n      $menuLinks.siblings('.c-header-resources__mobile-submenu').removeClass('open');\n      $(this).siblings('.c-header-resources__mobile-submenu').addClass('open');\n      $(this).addClass('resources__mobile-active');\n    });\n  }\n\n  function hideMenu(scrollCtrl = true) {\n    $mobileMenu.removeClass('open');\n    menuBtn.removeClass('is-active');\n    $menuLinks.siblings('.c-header-resources__mobile-submenu').removeClass('open');\n\n    if (scrollCtrl) {\n      scrollControll().enableScroll();\n    }\n  }\n\n  function hideMR() {\n    if ($(window).width() > 1024) {\n      hideMenu();\n    }\n  }\n\n  $(window).resize(() => hideMR()); // search input\n  // let isFocusedSearched = false;\n\n  const $headerSearchInput = $('#c-header-resources__search');\n  const cross = $('.c-header-resources .c-header-resources__search-cross-wrapper');\n  cross.on('mousedown', () => {\n    $headerSearchInput.val('');\n    $headerSearchInput.one('blur', () => {\n      $headerSearchInput.focus();\n    });\n  }); // blog header\n\n  $(window).click(() => {\n    $('.c-header-blog .c-header-resources__submenu').hide();\n    $('.c-header-blog .c-header-resources__menu-item span').removeClass('clicked');\n  });\n  $(document).ready(() => {\n    $('.c-header-blog .c-header-resources__menu-item').on('click', function (event) {\n      event.stopPropagation();\n      $('.c-header-blog .c-header-resources__submenu').not($(this).siblings('.c-header-resources__submenu')).hide();\n      $('.c-header-blog .c-header-resources__menu-item span').not($(this).children('span')).removeClass('clicked');\n      $(this).siblings('.c-header-resources__submenu').toggle();\n      $(this).children('span').toggleClass('clicked');\n    }); // hide item 'Resource Center' on focus input search\n    // $('.c-header-blog .c-header-resources__search')\n    //     .focus(() => {\n    //         isFocusedSearched = true;\n    //         $('.c-header-resources__resource-center').hide();\n    //     })\n    //     .blur(() => {\n    //         isFocusedSearched = false;\n    //         setTimeout(() => {\n    //             if (!isFocusedSearched) {\n    //                 $('.c-header-resources__resource-center').show();\n    //             }\n    //         }, 300);\n    //     });\n  }); // blog header mobile menu\n\n  $(document).ready(() => {\n    $('.c-header-resources__mobile-submenu-item').on('click', function () {\n      $(this).siblings('.c-header-resources__mobile-submenu-sub').slideToggle();\n      $(this).find('span').toggleClass('clicked');\n    });\n  });\n}\n// CONCATENATED MODULE: ./src/js/podcasts.js\n\nfunction ininPodcasts() {\n  const $container = $('.js-podcasts');\n  const $button = $('.c-resource-podcast .c-resource-podcast__button');\n  const ajaxURL = window.classy_data ? window.classy_data.ajaxData.adminAjaxUrl : null;\n  $('.js-custom-select', $container).select2({\n    minimumResultsForSearch: Infinity,\n    dropdownCssClass: 'podcast-select',\n    dropdownParent: $('.js-podcasts--filter-v')\n  });\n  $('.js-season-filter').on('change', function () {\n    const $filterWrap = $('.js-season-filter-wrap');\n    const $filterResults = $filterWrap.find('.js-season-filter-results');\n    const $pagination = $filterWrap.find('.js-resource-pagination');\n    $.ajax({\n      type: 'POST',\n      url: ajaxURL,\n      data: {\n        action: 'classy_load_resources',\n        season: $(this).prop('value'),\n        base_link_pagination: $pagination.attr('data-base-link')\n      },\n      dataType: 'json',\n      success: function (response) {\n        $filterResults.html(response); // console.log(response);\n      },\n      error: function () {// console.log(`${response.responseText} error`);\n      }\n    });\n  }); // $('.js-custom-select', $container).on('select2:select', (e) => {\n  //     const data1 = e.params.data;\n  //     const selectedSeason = data1.text.toLowerCase().split(' ').join('-');\n  //     if (selectedSeason === 'all-seasons') {\n  //         $('.c-resources__podcast').show();\n  //     }\n  //     else {\n  //         $('.c-resources__podcast').hide();\n  //         $(`.c-resources__podcast-${selectedSeason}`).show();\n  //     }\n  // });\n  // const changedOption = {\n  //     id: 'All Seasons',\n  //     text: 'All Seasons',\n  // };\n  // $('.js-custom-select', $container).val('All Seasons');\n  // $('.js-custom-select', $container).trigger('change.select2');\n  // $('.js-custom-select', $container).trigger({\n  //     type: 'select2:select',\n  //     params: {\n  //         data: changedOption,\n  //     },\n  // });\n\n  $(document).ready(() => {\n    $('.podcast-popup').magnificPopup({\n      type: 'inline',\n      preloader: false,\n      callbacks: {\n        open: () => {\n          scrollControll().disableScroll();\n        },\n        close: () => {\n          scrollControll().enableScroll();\n        }\n      }\n    });\n  });\n\n  if ($button.length) {\n    $button.on('click', () => {\n      const el = $('.c-resources__podcast:visible').first().find('.c-resource-podcast__popup');\n\n      if (el.length) {\n        $.magnificPopup.open({\n          items: {\n            src: el\n          },\n          type: 'inline'\n        });\n      }\n    });\n  }\n}\n// CONCATENATED MODULE: ./src/js/cut-the-chase.js\nfunction initCutTheChase() {\n  const cutTheChase = $('.c-resource-cut-chase');\n  const playButton = $('.c-resource-cut-chase__button-one', cutTheChase);\n  let currentVideo;\n  let currentTimeOfVideo = 0;\n  $(document).ready(() => {\n    window._wq = window._wq || [];\n    /* eslint no-underscore-dangle: 0 */\n\n    _wq.push({\n      id: '_all',\n      options: {\n        volumeControl: true\n      },\n      onReady: function (video) {\n        video.bind('popovershow', () => {});\n      }\n    });\n\n    if (cutTheChase.length) {\n      window._wq = window._wq || [];\n\n      _wq.push({\n        id: '_all',\n        onReady: function (video) {\n          video.bind('popoverhide', () => {\n            currentTimeOfVideo = video.time();\n            currentVideo = video;\n            video.pause();\n            const title = $(video.container).closest('.c-resource-post').find('h3').text();\n            $('.c-resource-cut-chase__video-info', cutTheChase).text(title);\n            $('.c-resource-cut-chase__resume', cutTheChase).show();\n            $('.c-resource-cut-chase__watch', cutTheChase).hide();\n          });\n        }\n      });\n\n      playButton.on('click', () => {\n        if ($('.c-resource-cut-chase__watch:visible').length) {\n          const firstPostCaption = $('#caption_content-0');\n\n          if (firstPostCaption.length) {\n            const firstResource = firstPostCaption.siblings('.wi